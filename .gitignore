# -------------------------------
# Data science outputs
# -------------------------------
# Large datasets (keep them out of git, store in DVC, MLflow, S3, etc.)
*.csv
*.tsv
*.parquet
*.feather
*.h5
*.db
*.sqlite
*.pkl
*.joblib
*.npy
*.npz

# Model artifacts
*.onnx
*.pt
*.pth
*.h5
*.ckpt
*.sav

# Results / outputs
*.pdf
*.png
*.jpg
*.jpeg
*.gif
*.svg

# -------------------------------
# MLflow / Experiment tracking
# -------------------------------
mlruns/
mlartifacts/
mlflow.db
backend.db
localMlflow/

# Grafana configs (ignore completely so Git won’t try to delete them)
localMlflow/config/grafana_*.yaml

